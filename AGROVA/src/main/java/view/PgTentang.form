                            <Component class="javax.swing.JLabel" name="lblWarnaJudulBesarSiapa">
                              <Properties><Property name="text" type="java.lang.String" value="Siapa kami"/><Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor"><Font name="Georgia" size="24" style="0"/></Property><Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor"><Color blue="3a" green="4d" red="1f" type="rgb"/></Property><Property name="alignmentX" type="float" value="0.0"/><Property name="border" type="javax.swing.border.Border" editor="org.netbeans.modules.form.editors2.BorderEditor"><Border info="org.netbeans.modules.form.compat2.border.EmptyBorderInfo"><EmptyBorder bottom="6" left="0" right="0" top="0"/></Border></Property></Properties>
                            </Component>
                            <Component class="javax.swing.JLabel" name="lblWarnaIsiBesarSiapa">
                              <Properties><Property name="text" type="java.lang.String" value="&lt;html&gt;&lt;div style=&quot;width:540px;line-height:1.5&quot;&gt;Perusahaan Root adalah perusahaan distribusi pupuk yang berpusat di Samarinda, Kalimantan Timur. Kami menghubungkan gudang pusat, kios penyalur di tiap kecamatan, dan petani dalam satu alur yang tercatat. AGROVA adalah sistem yang kami kembangkan untuk mencatat penyaluran pupuk subsidi maupun nonsubsidi, mengatur kuota petani berdasarkan golongan, dan memudahkan pemantauan stok di kios.&lt;br&gt;&lt;br&gt;Dengan pencatatan yang rapi dan transparan, kami ingin pupuk sampai ke tangan petani yang berhak, dalam jumlah yang tepat, dan pada waktu yang tepat, dari gudang pusat hingga kios di setiap kecamatan.&lt;/div&gt;"/><Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor"><Font name="Segoe UI" size="17" style="0"/></Property><Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor"><Color blue="4c" green="56" red="50" type="rgb"/></Property><Property name="alignmentX" type="float" value="0.0"/></Properties>
                            </Component>
                          </SubComponents>
                        </Container>
                        <Component class="javax.swing.JLabel" name="lblGbrSiapa">
                          <Properties><Property name="icon" type="javax.swing.Icon" editor="org.netbeans.modules.form.editors2.IconEditor"><Image iconType="3" name="/images/tentang/pabrik.jpg"/></Property><Property name="verticalAlignment" type="int" value="1"/></Properties>
                          <Constraints><Constraint layoutClass="org.netbeans.modules.form.compat2.layouts.DesignBorderLayout" value="org.netbeans.modules.form.compat2.layouts.DesignBorderLayout$BorderConstraintsDescription"><BorderConstraints direction="East"/></Constraint></Constraints>
                        </Component>
                      </SubComponents>
                    </Container>
                  </SubComponents>
                </Container>
