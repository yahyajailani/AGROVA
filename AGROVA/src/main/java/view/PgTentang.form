                            <Component class="javax.swing.JLabel" name="lblWarnaJudulCara">
                              <Properties><Property name="text" type="java.lang.String" value="Dari gudang sampai ke petani"/><Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor"><Font name="Georgia" size="17" style="0"/></Property><Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor"><Color blue="8c" green="54" red="1e" type="rgb"/></Property><Property name="alignmentX" type="float" value="0.0"/><Property name="border" type="javax.swing.border.Border" editor="org.netbeans.modules.form.editors2.BorderEditor"><Border info="org.netbeans.modules.form.compat2.border.EmptyBorderInfo"><EmptyBorder bottom="6" left="0" right="0" top="0"/></Border></Property></Properties>
                            </Component>
                            <Component class="javax.swing.JLabel" name="lblWarnaIsiCara">
                              <Properties><Property name="text" type="java.lang.String" value="&lt;html&gt;&lt;div style=&quot;width:740px;line-height:1.5&quot;&gt;1. Pengelola mencatat penyaluran dari gudang pusat ke kios di kecamatan tujuan.&lt;br&gt;2. Penyalur kios mengonfirmasi penerimaan, lalu stok kios bertambah.&lt;br&gt;3. Petani memesan atau penyalur menyalurkan langsung sesuai hak dan kuota petani.&lt;br&gt;4. Setiap transaksi tercatat dan nota dapat dicetak oleh penyalur.&lt;/div&gt;"/><Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor"><Font name="Segoe UI" size="13" style="0"/></Property><Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor"><Color blue="4c" green="56" red="50" type="rgb"/></Property><Property name="alignmentX" type="float" value="0.0"/></Properties>
                            </Component>
