        <Property name="text" type="java.lang.String" value="&lt;html&gt;&lt;div style=&quot;width:330px&quot;&gt;&lt;div style=&quot;font-family:Georgia;font-size:26px;color:white&quot;&gt;AGROVA&lt;/div&gt;&lt;div style=&quot;color:#cfe0d4;font-size:10px&quot;&gt;Distribusi pupuk subsidi &#xb7; Perusahaan Root &#xb7; Samarinda&lt;/div&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;font-family:Georgia;font-size:21px;color:white&quot;&gt;Pupuk subsidi sampai ke tangan yang tepat.&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;color:#e3ede5;font-size:11px&quot;&gt;Petani mendaftarkan lahan, penyalur mendaftarkan usahanya. Semua data tervalidasi dan tercatat.&lt;/div&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;color:white;font-size:11px&quot;&gt;"/>
        <Property name="horizontalTextPosition" type="int" value="0"/>
      </Properties>
